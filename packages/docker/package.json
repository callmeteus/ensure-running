{
    "name": "@ensure-running/docker",
    "version": "1.0.0",
    "description": "Docker provider for ensure-running",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ensure-running/core": "1.0.0"
    }
}
