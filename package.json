{
    "name": "ensure-docker-running",
    "version": "1.0.0",
    "description": "Ensure Docker is installed, started, and ready - cross-platform",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "bin": {
        "ensure-docker-running": "./dist/bin/ensure-docker-running.js",
        "edr": "./dist/bin/ensure-docker-running.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsx src/bin/ensure-docker-running.ts",
        "start": "node dist/bin/ensure-docker-running.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src tests --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
    },
    "keywords": [
        "docker",
        "daemon",
        "cli",
        "cross-platform",
        "docker-desktop"
    ],
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^2.1.8",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.4.2",
        "tsup": "^8.3.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.19.1",
        "vitest": "^2.1.8"
    }
}
